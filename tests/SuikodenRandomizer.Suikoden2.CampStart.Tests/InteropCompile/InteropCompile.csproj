<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net6.0</TargetFramework><AssemblyName>CampStart.RealInteropContract</AssemblyName></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/SuikodenRandomizer.Suikoden2Plugin/Gsd2CampStart.cs" Link="Production/Gsd2CampStart.cs" />
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExPath)/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(BepInExPath)/interop/*.dll" Exclude="$(BepInExPath)/interop/GSD1.dll;$(BepInExPath)/interop/GSD2.dll"><Private>false</Private></Reference>
    <Reference Include="GSD2"><HintPath>$(BepInExPath)/interop/GSD2.dll</HintPath><Private>false</Private><Aliases>GSD2</Aliases></Reference>
  </ItemGroup>
  <Target Name="RequireGameReferences" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(BepInExPath)/interop/GSD2.dll')" Text="Pass BepInExPath for a read-only compile against the game's generated interop." /></Target>
</Project>
