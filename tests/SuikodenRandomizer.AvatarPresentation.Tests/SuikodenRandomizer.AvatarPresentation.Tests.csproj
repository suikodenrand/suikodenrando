<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <!-- Keep this isolated two-reference test graph deterministic in the SDK's
         restore/build traversal; production plugin build settings are untouched. -->
    <BuildInParallel>false</BuildInParallel>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SuikodenRandomizer.Core/SuikodenRandomizer.Core.csproj" />
    <ProjectReference Include="FakeGsd1/FakeGsd1.csproj"><Aliases>GSD1</Aliases></ProjectReference>
    <Compile Remove="FakeGsd1/**/*.cs" />
    <Compile Include="../../src/SuikodenRandomizer.AvatarPlugin/AvatarPresentation.cs" Link="Production/AvatarPresentation.cs" />
  </ItemGroup>
</Project>
