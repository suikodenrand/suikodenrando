* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.nsi text eol=crlf
*.png binary
*.ico binary

# Preserve hash-pinned upstream notices/sources and reviewed default CFG bytes.
packaging/release/licenses/** -text
packaging/release/defaults/** -text
packaging/release/nexus-templates/** text eol=lf
